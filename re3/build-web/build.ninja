  FLAGS = -pthread -O3 -DNDEBUG
  LINK_FLAGS = -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1 -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=512MB -sMAXIMUM_MEMORY=2GB -sSTACK_SIZE=5MB -lopenal -sPTHREAD_POOL_SIZE=8 -sEXIT_RUNTIME=0 -sFORCE_FILESYSTEM=1 -sEXPORTED_RUNTIME_METHODS=FS,callMain -sUSE_MPG123=1 -sUSE_GLFW=3
  LINK_LIBRARIES = vendor/librw/src/librw.a  -lopenal  -lm  -lGL
  OBJECT_DIR = src\CMakeFiles\re3.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = src\re3.js
  TARGET_PDB = re3.js.dbg
  TARGET_SUPPORT_DIR = src\CMakeFiles\re3.dir
  RSP_FILE = CMakeFiles\re3.rsp


#############################################
# Utility command for edit_cache

build src/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\Projects\gta3\re3\build-web\src && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\Projects\gta3\re3 -BD:\Projects\gta3\re3\build-web"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build src/edit_cache: phony src/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\Projects\gta3\re3\build-web\src && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\Projects\gta3\re3 -BD:\Projects\gta3\re3\build-web"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/rebuild_cache: phony src/CMakeFiles/rebuild_cache.util

